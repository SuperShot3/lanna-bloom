{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/send-abandoned-checkout-emails",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/cleanup-custom-order-reference-images",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/purge-order-chats",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/expire-pay-links",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/google-ads-offline-conversions",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lannabloom.shop" }],
      "destination": "https://www.lannabloom.shop/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "lannabloom.shop" }],
      "destination": "https://www.lannabloom.shop/:path",
      "statusCode": 301
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    }
  ]
}
